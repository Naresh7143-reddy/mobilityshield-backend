              "mode": "raw",
              "raw": "{\n  \"deviceName\": \"Google Pixel 9 Pro\",\n  \"manufacturer\": \"Google\",\n  \"model\": \"Pixel 9 Pro\",\n  \"androidVersion\": \"15.0\",\n  \"sdkVersion\": 35,\n  \"securityPatchLevel\": \"2026-11-01\",\n  \"batteryPercentage\": 92,\n  \"charging\": false,\n  \"totalRam\": 17179869184,\n  \"availableRam\": 9663676416,\n  \"totalStorage\": 256000000000,\n  \"availableStorage\": 180000000000,\n  \"networkType\": \"WIFI\",\n  \"wifiConnected\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "enroll"]
