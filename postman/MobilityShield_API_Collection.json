            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"batteryPercentage\": 85,\n  \"charging\": true,\n  \"availableRam\": 8500000000,\n  \"totalRam\": 17179869184,\n  \"availableStorage\": 175000000000,\n  \"totalStorage\": 256000000000,\n  \"networkType\": \"WIFI\",\n  \"wifiConnected\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/telemetry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "telemetry"]
